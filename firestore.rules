rules_version = '2';

// MasalAI demo rules: fully open for development.
// WARNING: anyone with the project ID can read/write. Before any production
// or shared use, replace `true` with authenticated checks, e.g.
//   allow read, write: if request.auth != null;
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
